+    #[test]
+    fn exec_preserves_seccomp_profile() -> Result<(), LibcontainerError> {
+        use oci_spec::runtime::{LinuxSeccompBuilder, LinuxSeccompAction};
+        let filter = LinuxSeccompBuilder::default()
+            .default_action(LinuxSeccompAction::ScmpActErrno)
+            .default_errno_ret(1u32)
+            .build()?;
+        let mut container = Container::default();
+        container.set_pid(std::process::id() as i32);
+        let builder = tenant_builder().with_container_args(vec!["/bin/true".into()]);
+        for expected in [Some(filter), None] {
+            let mut spec = Spec::default();
+            spec.linux_mut().as_mut().unwrap().set_seccomp(expected.clone());
+            builder.adapt_spec_for_tenant(&mut spec, &container)?;
+            assert_eq!(spec.linux().as_ref().unwrap().seccomp(), &expected);
+        }
+        Ok(())
